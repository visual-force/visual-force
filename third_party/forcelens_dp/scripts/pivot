#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python}"
RAW_DATASET="${RAW_DATASET:-data/pivot/pivoting_cheng}"
DATASET_PATH="${DATASET_PATH:-data/pivot/pivoting_cheng_success}"

usage() {
  cat <<'EOF'
Pivot commands

  scripts/pivot build
  scripts/pivot train [Hydra overrides...]

The builder selects valid stage1/stage2 records from successful demonstrations
in data/pivot/pivoting_cheng and writes a manifest-backed training view.

Environment overrides: PYTHON_BIN, RAW_DATASET, DATASET_PATH, TRAIN_DEVICE,
WANDB_MODE, and BUILD_DATASET.
EOF
}

build_dataset() {
  cd "${REPO_ROOT}"
  "${PYTHON_BIN}" tools/pivot/build_pivoting_cheng_dataset.py \
    --source "${RAW_DATASET}" \
    --output "${DATASET_PATH}" \
    --overwrite
}

run_train() {
  cd "${REPO_ROOT}"
  if [[ "${BUILD_DATASET:-1}" == "1" ]]; then
    build_dataset
  fi
  WANDB_MODE="${WANDB_MODE:-offline}" \
  WANDB_DISABLE_SERVICE="${WANDB_DISABLE_SERVICE:-true}" \
  "${PYTHON_BIN}" train.py \
    --config-name=train_diffusion_unet_pick_berries_hybrid_workspace \
    task=pick_berries_all_image \
    name=train_diffusion_unet_pivoting_cheng_absolute_quantile \
    task.name=pivoting_cheng_image \
    task.dataset_path="${DATASET_PATH}" \
    task.dataset.relative_position_action=false \
    task.dataset.relative_gripper_action=false \
    task.dataset.action_normalizer_mode=quantile \
    task.dataset.gripper_action_normalizer_mode=limits \
    task.dataset.agent_pos_normalizer_mode=quantile \
    training.device="${TRAIN_DEVICE:-cuda:0}" \
    training.resume=false \
    logging.mode="${WANDB_MODE:-offline}" \
    'logging.tags=[pivoting_cheng,success_only,absolute,quantile]' \
    "$@"
}

command_name="${1:-help}"
if (( $# > 0 )); then
  shift
fi
case "${command_name}" in
  help|-h|--help) usage ;;
  build) build_dataset ;;
  train) run_train "$@" ;;
  *) echo "Unknown pivot command: ${command_name}" >&2; usage >&2; exit 2 ;;
esac
